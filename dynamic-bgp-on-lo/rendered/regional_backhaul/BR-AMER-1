end

######################################
# optional/11-Edge-SDWAN.j2
######################################
config firewall address
  edit "CORP_LAN"
    set subnet 10.0.0.0/8
  next
  edit "PRH_LAN_1"
    set subnet 10.20.0.0/16
  next
  edit "BRH_LAN_1"
    set subnet 10.10.0.0/16
  next
end
config firewall addrgrp
  edit "PRH_LAN"
    set member "PRH_LAN_1"
  next
  edit "BRH_LAN"
    set member "BRH_LAN_1"
  next
end
config system sdwan
  set status enable
  config zone
    edit "underlay"
    next
    edit "gh_overlay"
      set advpn-select enable
    next
    edit "prh_overlay"
    next
    edit "brh_overlay"
    next
  end
  config members
    edit 1
      set interface "port1"
      set zone "underlay"
      unset source
      set cost 0
      # Best priority, used for Internet access in implicit rule / local-out
      set priority 1
      # Gateway is fetched from DHCP
    next
    edit 2
      set interface "port2"
      set zone "underlay"
      unset source
      set cost 0
      # Best priority, used for Internet access in implicit rule / local-out
      set priority 1
      # Gateway is fetched from DHCP
    next
    edit 3
      set interface "GH1_ISP1"
      set priority 10
      set source 10.200.2.1
      set preferred-source 10.200.2.1
      set cost 0
      set zone "gh_overlay"
      set priority-in-sla 5
      set priority-out-sla 995
      set transport-group 0
    next
    edit 4
      set interface "GH1_ISP2"
      set priority 10
      set source 10.200.2.1
      set preferred-source 10.200.2.1
      set cost 0
      set zone "gh_overlay"
      set priority-in-sla 5
      set priority-out-sla 995
      set transport-group 0
    next
    edit 5
      set interface "GH2_ISP1"
      set priority 10
      set source 10.200.2.1
      set preferred-source 10.200.2.1
      set cost 0
      set zone "gh_overlay"
      set priority-in-sla 6
      set priority-out-sla 996
      set transport-group 0
    next
    edit 6
      set interface "GH2_ISP2"
      set priority 10
      set source 10.200.2.1
      set preferred-source 10.200.2.1
      set cost 0
      set zone "gh_overlay"
      set priority-in-sla 6
      set priority-out-sla 996
      set transport-group 0
    next
    edit 7
      set interface "PRH_ISP1"
      set priority 10
      set source 10.200.2.1
      set preferred-source 10.200.2.1
      set cost 0
      set zone "prh_overlay"
    next
    edit 8
      set interface "PRH_ISP2"
      set priority 10
      set source 10.200.2.1
      set preferred-source 10.200.2.1
      set cost 0
      set zone "prh_overlay"
    next
    edit 9
      set interface "BRH_ISP1"
      set priority 10
      set source 10.200.2.1
      set preferred-source 10.200.2.1
      set cost 0
      set zone "brh_overlay"
    next
    edit 10
      set interface "BRH_ISP2"
      set priority 10
      set source 10.200.2.1
      set preferred-source 10.200.2.1
      set cost 0
      set zone "brh_overlay"
    next
  end
  config health-check
    edit "HUB"
      set server 10.200.99.1
      set vrf 0
      set sla-fail-log-period 10
      set sla-pass-log-period 10
      set embed-measured-health enable
      set sla-id-redistribute 1
      set members 3 4 5 6
      config sla
        edit 1
          set link-cost-factor latency
          set latency-threshold 100
        next
      end
    next
    delete "Internet"
    edit "INET"
      set server "8.8.8.8"
      set vrf 0
      set sla-fail-log-period 10
      set sla-pass-log-period 10
      set update-cascade-interface disable
      set update-static-route enable
      set members 7 8 9 10
    next
    edit "PRH"
      set server "10.200.0.12"
      set vrf 0
      set sla-fail-log-period 10
      set sla-pass-log-period 10
      set update-cascade-interface disable
      set update-static-route disable
      set members 7 8
    next
    edit "BRH"
      set server "10.200.0.11"
      set vrf 0
      set sla-fail-log-period 10
      set sla-pass-log-period 10
      set update-cascade-interface disable
      set update-static-route disable
      set members 9 10
    next
  end
  config neighbor
    edit 10.200.0.1
      set member 3 4
      set route-metric priority
      set health-check "HUB"
    next
    edit 10.200.0.2
      set member 5 6
      set route-metric priority
      set health-check "HUB"
    next
  end
  config service
    edit 5
      set name "Regional-PRH"
      set mode priority
      set dst "PRH_LAN"
      set src "CORP_LAN"
      set health-check "PRH" "HUB"
      # Directly to the Regional Hub, then via the Global Hubs
      set priority-members 7 8 3 4 5 6
    next
    edit 6
      set name "Regional-BRH"
      set mode priority
      set dst "BRH_LAN"
      set src "CORP_LAN"
      set health-check "BRH" "HUB"
      # Directly to the Regional Hub, then via the Global Hubs
      set priority-members 9 10 3 4 5 6
    next
    edit 1
      set name "Corporate"
      set mode sla
      set dst "CORP_LAN"
      set src "CORP_LAN"
      set tie-break fib-best-match
      config sla
        edit "HUB"
          set id 1
        next
      end
      set priority-members 3 4 5 6
    next
    delete 10
    edit 20
      set name "Internet"
      set mode priority
      set dst "all"
      set src "CORP_LAN"
      set health-check "INET"
      # Primary Regional Hub, then backup Regional Hub (only when all primary members fail)
      set priority-members 7 8 9 10
    next
    move 5 before 1
    move 6 before 1
  end
  config zone
    edit "gh_overlay"
      set advpn-health-check "HUB"
    next
  end  
end
config router static
  edit 100
    set dst 0.0.0.0/0
    set sdwan-zone "prh_overlay"
    set priority 1
  next
  edit 101
    set dst 0.0.0.0/0
    set sdwan-zone "brh_overlay"
    set priority 10
  next
  edit 102
    set dst 0.0.0.0/0
    set sdwan-zone "underlay"
    set priority 100
  next
end

######################################
# optional/12-Edge-Firewall.j2
######################################
config firewall address
  edit "CORP_LAN"
    set subnet 10.0.0.0/8
  next
end
config firewall policy
  purge
  edit 1
    set name "Corporate"
    set srcintf lan_zone "gh_overlay"
    set dstintf lan_zone "gh_overlay"
    set srcaddr "CORP_LAN"
    set dstaddr "CORP_LAN"
    set action accept
    set schedule "always"
    set service "ALL"
    set utm-status enable
    set ssl-ssh-profile certificate-inspection
    set application-list "default"
    set logtraffic all
  next
  edit 2
    set name "Regional"
    set srcintf lan_zone "prh_overlay" "brh_overlay"
    set dstintf lan_zone "prh_overlay" "brh_overlay"
    set srcaddr "CORP_LAN"
    set dstaddr "CORP_LAN"
    set action accept
    set schedule "always"
    set service "ALL"
    set utm-status enable
    set ssl-ssh-profile certificate-inspection
    set application-list "default"
    set logtraffic all
  next
  edit 4
    set name "Internet (RH)"
    set srcintf lan_zone
    set dstintf "prh_overlay" "brh_overlay"
    set srcaddr "all"
    set dstaddr "all"
    set action accept
    set schedule "always"
    set service "ALL"
    set utm-status enable
    set ssl-ssh-profile certificate-inspection
    set application-list "default"
    set logtraffic all
  next
  edit 5
    set name "Peering"
    set srcintf "gh_overlay" "prh_overlay" "brh_overlay"
    set dstintf "Lo"
    set srcaddr "all"
    set dstaddr "all"
    set action accept
    set schedule "always"
    set service "PING" "BGP"
  next
end

execute batch end
