######################################
config router prefix-list
  edit "PRH_LAN"
    config rule
      purge
      edit 1
        set prefix 10.20.0.0/16
        unset ge
        set le 32
      next
    end
  next
  edit "BRH_LAN"
    config rule
      purge
      edit 1
        set prefix 10.10.0.0/16
        unset ge
        set le 32
      next
    end
  next
end
config router route-map
  edit "PRH_IN"
    config rule
      purge
      edit 1
        set match-ip-address "PRH_LAN"
        set set-local-preference 200
      next
    end
  next
  edit "BRH_IN"
    config rule
      purge
      edit 1
        set match-ip-address "BRH_LAN"
        set set-local-preference 150
      next
    end
  next
end
config router bgp
  config neighbor
    edit 10.200.0.12
      set description "PRH: RH-AMER"
      set soft-reconfiguration enable
      set capability-graceful-restart enable
      set advertisement-interval 1
      set interface "Lo"
      set update-source "Lo"
      set connect-timer 1
      set remote-as 65000
      set route-map-in "PRH_IN"
      set route-map-out "LAN_OUT"
    next
    edit 10.200.0.11
      set description "BRH: RH-EMEA"
      set soft-reconfiguration enable
